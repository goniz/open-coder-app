# Bazel configuration

# Increase build output for debugging
build --announce_rc

# Set macOS deployment target for host tools (like macro plugins)
build --macos_minimum_os=14.0
build --host_macos_minimum_os=14.0

# Force IPA compression
build --define=apple.compress_ipa=yes

# Release configuration for App Store builds
build:release -c opt
build:release --ios_multi_cpus=arm64
build:release --apple_generate_dsym
build:release --define=apple.add_debugger_entitlement=no

# Enable disk cache for faster builds
build --disk_cache=~/.cache/bazel
build --experimental_disk_cache_gc_max_size=30G
build --experimental_disk_cache_gc_max_age=7d

build --bes_results_url=https://goniz.buildbuddy.io/invocation/
build --bes_backend=grpcs://goniz.buildbuddy.io
build --remote_cache=grpcs://goniz.buildbuddy.io
build --remote_timeout=10m
build --remote_cache_compression

# more detailed timing profile
build --noslim_profile --experimental_profile_include_target_label --experimental_profile_include_primary_output

# selectively disable remote capabilities for certain build actions, which can improve overall build performance. For iOS builds, we recommend:
build --modify_execution_info=^(AppleLipo|BitcodeSymbolsCopy|BundleApp|BundleTreeApp|DsymDwarf|DsymLipo|GenerateAppleSymbolsFile|ObjcBinarySymbolStrip|CppArchive|CppLink|ObjcLink|ProcessAndSign|SignBinary|SwiftArchive|SwiftStdlibCopy)$=+no-remote,^(BundleResources|ImportedDynamicFrameworkProcessor)$=+no-remote-exec
try-import .bazelrc-user
