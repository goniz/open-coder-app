load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application")
load("//bazel:plist.bzl", "extract_xcode_version", "generate_plist")

# Root BUILD file for OpenCoder workspace

filegroup(
    name = "package_files",
    srcs = [
        "Package.swift",
        "Package.resolved",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "swift_perception_patches",
    srcs = ["patches/swift-perception-compiler-guard.patch"],
    visibility = ["//visibility:public"],
)

# Alias to the generated OpenCoderCore from Swift Package Manager
alias(
    name = "OpenCoderCore",
    actual = "@swiftpkg_opencodercore//:OpenCoderCore",
    visibility = ["//visibility:public"],
)

# Alias to the generated OpenCoderUI from Swift Package Manager
alias(
    name = "OpenCoderUI",
    actual = "@swiftpkg_opencoderui//:OpenCoderUI",
    visibility = ["//visibility:public"],
)

# Alias to the generated OpenCoderApp from Swift Package Manager
alias(
    name = "OpenCoderApp",
    actual = "@swiftpkg_opencoderapp//:OpenCoderApp",
    visibility = ["//visibility:public"],
)

# Extract version from Xcode project (single source of truth)
extract_xcode_version(
    name = "xcode_version",
    xcode_project = "//Xcode:OpenCoder.xcodeproj/project.pbxproj",
)

# Generate Info.plist for AppStore variant
generate_plist(
    name = "Info_plist",
    template = "Info.plist.template",
    version_info = ":xcode_version",
    display_name = "Open Coder",
    output_name = "Info.plist",
)

# Generate Info.plist for Preview variant
generate_plist(
    name = "Info_preview_plist",
    template = "Info.plist.template",
    version_info = ":xcode_version",
    display_name = "Open Coder (Preview)",
    output_name = "Info.preview.plist",
)

# iOS Application target - Preview
ios_application(
    name = "OpenCoder.preview",
    bundle_id = "com.goniz.opencoderapp.preview",
    families = [
        "iphone",
    ],
    infoplists = [":Info_preview_plist"],
    minimum_os_version = "17.0",
    provisioning_profile = "//Xcode:development_preview_profile",
    resources = [
        "//Xcode:app_assets",
    ],
    deps = [
        "@swiftpkg_opencoderapp//:OpenCoderApp",
    ],
)

# iOS Application target - App Store
ios_application(
    name = "OpenCoder.appstore",
    bundle_id = "com.goniz.opencoderapp",
    families = [
        "iphone",
    ],
    infoplists = [":Info_plist"],
    minimum_os_version = "17.0",
    provisioning_profile = "//Xcode:appstore_profile",
    resources = [
        "//Xcode:app_assets",
    ],
    deps = [
        "@swiftpkg_opencoderapp//:OpenCoderApp",
    ],
)

# Default alias to preview variant
alias(
    name = "OpenCoder",
    actual = ":OpenCoder.preview",
    visibility = ["//visibility:public"],
)
