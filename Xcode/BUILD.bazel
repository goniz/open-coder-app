load("@build_bazel_rules_apple//apple:apple.bzl", "local_provisioning_profile")

# Export Xcode project file for version extraction
exports_files([
    "OpenCoder.xcodeproj/project.pbxproj",
    "OpenCoder/OpenCoder.entitlements",
])

# App Icons asset catalog
filegroup(
    name = "app_assets",
    srcs = glob([
        "OpenCoder/Assets.xcassets/**",
    ]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "preview_profile",
    srcs = [":adhoc_com.goniz.opencoderapp.preview.mobileprovision"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "appstore_profile",
    srcs = [":AppStore_com.goniz.opencoderapp.mobileprovision"],
    visibility = ["//visibility:public"],
)


