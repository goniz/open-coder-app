# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

opt_out_usage

default_platform(:ios)

platform :ios do
  # Mirror CI behavior: skip Xcode's macro and package plugin fingerprint validation
  # so that updates (e.g., PerceptionMacros, swift-openapi-generator) don't block builds.
  before_all do
    sh("defaults write com.apple.dt.Xcode IDESkipMacroFingerprintValidation -bool YES")
    sh("defaults write com.apple.dt.Xcode IDESkipPackagePluginFingerprintValidatation -bool YES")
  end

  desc "Build for development without publishing"
  lane :build do
    puts "🔨 Building development IPA with Bazel..."
    sh("cd ../.. && bazel build //:OpenCoder.preview")
    puts "✅ Development build completed successfully"
  end

  desc "Build preview IPA using Bazel"
  lane :preview do |options|
    quiet = options[:quiet] || false
    
    api_key = app_store_connect_api_key(
      key_id: "ZZR4FFP696",
      issuer_id: "d5f4a2be-8aae-409d-9526-b299f949a6d9",
      key_filepath: "./fastlane/AuthKey_ZZR4FFP696.p8"
    )
    get_certificates(
      development: false,
      api_key: api_key
    )
    get_provisioning_profile(
      app_identifier: "com.goniz.opencoderapp.preview",
      adhoc: true,
      api_key: api_key
    )
    
    # Increment Xcode build number (source of truth)
    increment_build_number(xcodeproj: "OpenCoder.xcodeproj")
    
    bazel_flags = quiet ? "--ui_event_filters=-info,-debug --noshow_progress" : ""
    
    puts "🔨 Building preview IPA with Bazel (auto-extracting versions)..." unless quiet
    sh("cd ../.. && bazel build --config=release #{bazel_flags} //:OpenCoder.preview")
    
    fastlane_dir = File.dirname(__FILE__)
    ipa_path = File.expand_path("../../bazel-bin/OpenCoder.preview.ipa", fastlane_dir)
    
    unless File.exist?(ipa_path)
      UI.user_error!("Preview IPA not found at #{ipa_path} after Bazel build.")
    end
    
    puts "✅ Preview IPA created: #{ipa_path}" unless quiet
  end

  desc "Generate screenshots for development"
  lane :screenshots do
    capture_screenshots(
      workspace: "OpenCoder.xcworkspace",
      scheme: "OpenCoder",
      configuration: "Debug",
      devices: ["iPhone 16 Pro"],
      languages: ["en-US"],
      output_directory: "./screenshots"
    )
  end

  desc "Publish to App Store using Bazel-built IPA"
  lane :appstore do
    api_key = app_store_connect_api_key(
      key_id: "ZZR4FFP696",
      issuer_id: "d5f4a2be-8aae-409d-9526-b299f949a6d9",
      key_filepath: "./fastlane/AuthKey_ZZR4FFP696.p8"
    )
    get_certificates(
      development: false,
      api_key: api_key
    )
    get_provisioning_profile(
      app_identifier: "com.goniz.opencoderapp",
      adhoc: false,
      api_key: api_key
    )
    
    # Increment Xcode build number (source of truth)
    increment_build_number(xcodeproj: "OpenCoder.xcodeproj")
    
    puts "🔨 Building IPA with Bazel (auto-extracting versions)..."
    sh("cd ../.. && bazel build --config=release //:OpenCoder.appstore")
    
    fastlane_dir = File.dirname(__FILE__)
    ipa_path = File.expand_path("../../bazel-bin/OpenCoder.appstore.ipa", fastlane_dir)
    
    unless File.exist?(ipa_path)
      UI.user_error!("IPA not found at #{ipa_path} after Bazel build.")
    end
    
    puts "📦 Uploading IPA to TestFlight and waiting for processing..."
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      app_platform: "ios",
      skip_waiting_for_build_processing: false
    )
    
    puts "✅ IPA uploaded and processed successfully in TestFlight"
  end

  desc "Check TestFlight build processing status"
  lane :check_builds do
    api_key = app_store_connect_api_key(
      key_id: "ZZR4FFP696",
      issuer_id: "d5f4a2be-8aae-409d-9526-b299f949a6d9",
      key_filepath: "./fastlane/AuthKey_ZZR4FFP696.p8"
    )
    
    # Get latest builds from TestFlight
    builds = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.goniz.opencoderapp",
      initial_build_number: 1
    )
    
    puts "🔍 Latest TestFlight build: #{builds}"
    puts "📱 Local build number: #{get_build_number(xcodeproj: 'OpenCoder.xcodeproj')}"
  end
end
