module(name = "opencoder")

bazel_dep(name = "rules_apple", version = "4.2.0", repo_name = "build_bazel_rules_apple")
bazel_dep(name = "rules_swift", version = "3.1.2", repo_name = "build_bazel_rules_swift")
bazel_dep(name = "rules_swift_package_manager", version = "1.7.0")
archive_override(
    module_name = "rules_swift_package_manager",
    integrity = "sha256-YwzQXIw7VLT1f7voUqWGdhfGucevyqYiuuV2XCfSP54=",
    patch_strip = 1,
    patches = ["//:patches/rules-swift-package-manager-reproducible.patch"],
    urls = ["https://github.com/cgrindel/rules_swift_package_manager/releases/download/v1.7.0/rules_swift_package_manager.v1.7.0.tar.gz"],
)

# The apple_support bazel_dep must come before the rules_cc.
# https://github.com/bazelbuild/apple_support#incompatible-toolchain-resolution
bazel_dep(name = "apple_support", version = "1.21.1")
bazel_dep(name = "rules_cc", version = "0.1.2")

apple_cc_configure = use_extension(
    "@apple_support//crosstool:setup.bzl",
    "apple_cc_configure_extension",
)
use_repo(apple_cc_configure, "local_config_apple_cc")

swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)
swift_deps.from_package(
    declare_swift_deps_info = True,
    resolved = "//:Package.resolved",
    swift = "//:Package.swift",
)
swift_deps.configure_package(
    name = "swift-perception",
    patch_args = ["-p1"],
    patches = ["//:patches/swift-perception-compiler-guard.patch"],
)
swift_deps.configure_package(
    name = "swift-sharing",
    patch_args = ["-p1"],
    patches = ["//:patches/swift-sharing-compiler-guard.patch"],
)
swift_deps.configure_package(
    name = "swift-composable-architecture",
    patch_args = ["-p1"],
    patches = ["//:patches/tca-compiler-guard.patch"],
)
use_repo(
    swift_deps,
    "swift_deps_info",
    "swift_package",
    "swiftpkg_opencoderapp",
    "swiftpkg_opencodercore",
    "swiftpkg_opencoderui",
    "swiftpkg_swift_openapi_generator",
)
